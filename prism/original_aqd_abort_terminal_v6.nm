// Original AQD early-abort semantics with an explicit application timeout.
// Initial state: t3 after decoy detection passed.
mdp

module original_aqd_abort_with_timeout
    phase : [3..10] init 3;
    Pass_decoy : bool init true;
    AliceKnowsB : bool init false;
    BobKnowsA : bool init false;
    aborted_by_alice : bool init false;
    BobWaitingForCA : bool init false;
    timed_out : bool init false;
    terminal : bool init false;
    OutA_has_B : bool init false;
    OutB_abort : bool init false;

    [send_cb] phase=3 & Pass_decoy -> (phase'=5);
    [alice_recovers_b] phase=5 -> (phase'=6) & (AliceKnowsB'=true) & (OutA_has_B'=true);
    [continue] phase=6 & AliceKnowsB -> (phase'=7);
    [send_ca] phase=7 & !aborted_by_alice -> (phase'=10) & (BobKnowsA'=true) & (terminal'=true);
    [alice_abort] phase=6 & AliceKnowsB & !BobKnowsA -> (phase'=7) & (aborted_by_alice'=true);
    [bob_waiting_for_ca] phase=7 & aborted_by_alice -> (phase'=8) & (BobWaitingForCA'=true);
    [timeout] phase=8 & BobWaitingForCA -> (phase'=9) & (timed_out'=true);
    [bob_abort] phase=9 & timed_out -> (phase'=10) & (terminal'=true) & (OutB_abort'=true);
    [delay] phase=8 & BobWaitingForCA -> (phase'=phase);
endmodule

label "terminal_unfair_abort" = terminal & timed_out & aborted_by_alice & AliceKnowsB & !BobKnowsA;
label "terminal_output_unfair" = terminal & OutA_has_B & OutB_abort;
